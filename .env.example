# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- GEOSPATIAL & METEOROLOGICAL INTEGRATIONS (OPTIONAL) ---
# MOBILITY is 100% functional out-of-the-box using CARTO Positron / OSM tiles,
# OpenRouteService / OSRM, Open-Meteo, and internal campus zone directories.

# MAP TILES:
# Defaults to CARTO Positron light aesthetic. Fallback automatically switches to standard OSM on error.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a> contributors, &copy; <a href=\"https://carto.com/attributions\" target=\"_blank\" rel=\"noopener\">CARTO</a>"

# ROUTING CONFIGURATION:
# OPENROUTESERVICE_API_KEY: (Optional) OpenRouteService Directions API key
# Free registration at https://openrouteservice.org/ (2,000 requests/day free tier).
OPENROUTESERVICE_API_KEY=""

# ROUTING_FALLBACK_PROVIDER: Secondary routing provider if OpenRouteService is unavailable or unconfigured.
# Options: "osrm" (default, public demo server), "none" (use offline campus curvature model immediately).
ROUTING_FALLBACK_PROVIDER="osrm"

# OSRM_ROUTING_URL: Custom or self-hosted OSRM endpoint (default: public demo server)
OSSRM_ROUTING_URL="https://router.project-osrm.org"

# GEOCODING & NOMINATIM COMPLIANCE:
# OPENCAGE_API_KEY: (Optional) OpenCage Geocoding API key
# Free registration at https://opencagedata.com/ (2,500 requests/day free tier).
OPENCAGE_API_KEY=""

# NOMINATIM POLICY CONFIGURATION:
# Rate limit interval in milliseconds (OpenStreetMap policy requires >= 1000ms; default: 1100ms)
NOMINATIM_RATE_LIMIT_MS="1100"
# Contact email included in Nominatim request User-Agent header for usage compliance
NOMINATIM_EMAIL="contact@mobility-campus.local"
NOMINATIM_USER_AGENT=""

# WEATHER INTELLIGENCE:
# Open-Meteo: Free non-commercial access (up to 10,000 requests/day).
# No API key required.
