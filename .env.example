# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- GEOSPATIAL & METEOROLOGICAL INTEGRATIONS (OPTIONAL) ---
# MOBILITY is fully functional without external keys through OpenStreetMap Nominatim,
# OSRM public routing, Open-Meteo, and campus zone gazetteer fallbacks.

# OPENROUTESERVICE_API_KEY: (Optional) OpenRouteService Directions API key
# Free registration at https://openrouteservice.org/ (2,000 requests/day free tier).
# If unconfigured, routing automatically falls back to public OSRM and the campus road model.
OPENROUTESERVICE_API_KEY=""

# OPENCAGE_API_KEY: (Optional) OpenCage Geocoding API key
# Free registration at https://opencagedata.com/ (2,500 requests/day free tier).
# If unconfigured, geocoding automatically falls back to OpenStreetMap Nominatim and campus zones.
OPENCAGE_API_KEY=""

# Open-Meteo (Weather): Free non-commercial access (up to 10,000 requests/day).
# No API key required.
